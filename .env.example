# ── Desenvolvimento local ─────────────────────────────────────────────────────
SECRET_KEY=troque-por-uma-chave-segura-em-producao
FLASK_DEBUG=1
PORT=5000

# Caminho do banco (padrao: %APPDATA%/FluxoBarber/fluxo_barber.db no Windows)
# FLUXO_BARBER_DB=/caminho/para/fluxo_barber.db

# ── Producao (Railway) ────────────────────────────────────────────────────────
# SECRET_KEY=<string longa e aleatoria>
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# FLUXO_BARBER_DB=/data/fluxo_barber.db

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
